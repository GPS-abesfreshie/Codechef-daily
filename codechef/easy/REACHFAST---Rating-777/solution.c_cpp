#include <bits/stdc++.h>
using namespace std;

int main() {
	int T;
	cin>>T;
	while(T--){
	    int A,B,K,ans;
	    cin>>A>>B>>K;
	    int step;
        if(A==B){
            cout<<0<<"\n";
        }
        else if(A>B){
                step=A-B;
                if(step%K==0){
            cout<<step/K<<endl;
        }
        else{
            cout<<(step/K)+1<<endl;
        }
        }
        else{
            step=B-A;
            if(step%K==0){
            cout<<step/K<<endl;
        }
        else{
            cout<<(step/K)+1<<endl;
        }
    }
	}
}
