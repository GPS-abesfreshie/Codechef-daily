#include <bits/stdc++.h>
using namespace std;

int main() {
	int T;
	cin>>T;
	while(T--){
	    int N;
	    cin>>N;
	    vector<int>ans;
	    ans.push_back(1);
	    for(int x=2;x<=N;x++){
	        int carry=0;
	        for(size_t i=0;i<ans.size();i++){
	            int prod=ans[i]*x+carry;
	            ans[i]=prod%10;
	            carry=prod/10;
	        }
	    while(carry){
	        ans.push_back(carry%10);
	        carry/=10;
	    }     
	    }
	    for(int i=ans.size()-1;i>=0;i){
	        cout<<ans[i];
	    }
	    cout<<"\n";
	}
}