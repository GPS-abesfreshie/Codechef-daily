#include <bits/stdc++.h>
using namespace std;

int main() {
	int T;
	cin>>T;
	while(T--){
	    int X,Y,Z;
	    cin>>X>>Y>>Z;
	    if(Z>=X*Y){
	        cout<<0<<endl;
	    }
	    else if(X*Y>Z){
	        if((X*Y-Z)%Y==0){
	            cout<<(X*Y-Z)/Y<<endl;
	        }
	        else{
	            cout<<((X*Y-Z)/Y)+1<<endl;
	        }
	    }
	}
}
