#include <bits/stdc++.h>
using namespace std;

int main() {
	int T;
	cin>>T;
	while(T--){
	    int S,X,Y,Z;
	    cin>>S>>X>>Y>>Z;
	    int left=S-X-Y;
	    int need=Z-left;
	    if(need<=0){
	        cout<<0<<endl;
	    }
	    else if(need<=X || need<=Y){
	        cout<<1<<endl;
	    }
	    else{
	        cout<<2<<endl;
	    }
	}
}
