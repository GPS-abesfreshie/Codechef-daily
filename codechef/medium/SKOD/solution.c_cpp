#include <bits/stdc++.h>
using namespace std;

int main() {
	int T;
	cin>>T;
	while(T--){
	    int N;
	    cin>>N;
	    int arr[N];
	    for(int i=0;i<N;i++){
	        cin>>arr[i];
	    }
	    int ans=arr[0];
	    int sum=0;
	    for(int i=0;i<N;i++){
	        if(arr[i]<ans){
	            ans=arr[i];
	        }
	        sum+=arr[i];
	    }
	    cout<<sum-ans<<endl;
	}
}
