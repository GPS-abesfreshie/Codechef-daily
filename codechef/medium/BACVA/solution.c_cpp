#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;
    while (T--) {
        string A;
        cin >> A;
        long long sum = 0;
        for (char digit : A) {
            sum += (digit - '0');
        }
        
        if (sum % 10 == 0) {
            cout << "Valid\n";
        }
        else {
            cout << "Invalid\n";
        }
    }
    return 0;
}
