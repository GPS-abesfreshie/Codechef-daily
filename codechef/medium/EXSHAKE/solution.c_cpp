#include <bits/stdc++.h>
using namespace std;

int main() {
	int T;
	cin>>T;
	while(T--){
	    int N,M;
	    cin>>N>>M;
	    int A[N];
	    for(int i=0;i<N;i++){
	        cin>>A[i];
	    }
	    int count=0;
	    int totall=0;
	    for(int i=0;i<N;i++){
	        if(totall*(totall-1)/2>M){
	            break;
	        }
	        else{
	            totall+=A[i];
	            count+=1;
	        }
	    }
	    cout<<count<<endl;
	}
}
