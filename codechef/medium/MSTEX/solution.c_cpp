#include <bits/stdc++.h>
using namespace std;

int main() {
	int T;
	cin>>T;
	while(T--){
	    int N,K;
	    cin>>N>>K;
	    int arr[N];
	    for(int i=0;i<N;i++){
	        cin>>arr[i];
	    }
	    int ans=0;
	    int max=arr[0],a=0;
	    while(K--){
	        for(int i=0;i<N;i++){
	            if(arr[i]>max){
	                max=arr[i];
	                a=i;
	            }
	        }
	        ans+=max;
	        arr[a]=-1;
	    }
	    cout<<ans<<endl;
	}
}
