#include <bits/stdc++.h>
using namespace std;

int main() {
	int T;
	cin>>T;
	while(T--){
	    int N;
	    cin>>N;
	    vector<int> A(N);
	    int sum=0;
	    for(int i=0;i<N;i++){
	        cin>>A[i];
	        sum+=A[i];
	    }
	    int maxi=INT_MAX;
	    for(int i=0;i<N-1;i++){
	        maxi=min(maxi,A[i]+A[i+1]);
	    }
	    cout<<sum-maxi/2<<endl;
	}
}
