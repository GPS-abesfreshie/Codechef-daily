#include <bits/stdc++.h>
using namespace std;

int main() {
	int T;
	cin>>T;
	while(T--){
	    int N;
	    cin>>N;
	    vector<int> A(N);
	    int sum=0;
	    for(int i=0;i<N;i++){
	        cin>>A[i]; 
	    }
	    sort(A.begin(),A.end());
	    for(int i=0;i<N;i++){
	        if(i<2){
	            sum=sum+(A[i]/2);
	        }
	        else{
	            sum=sum+A[i];
	        }
	    }
	    cout<<sum<<endl;
	}
}
